{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Jwt": {
    "Key": "",
    "Issuer": "IRS.API",
    "Audience": "IRS.Web",
    "HorasExpiracion": 8,
    "CookieName": "__Host-irs_access_token",
    "CookieSameSite": "Lax"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4300",
      "http://localhost:4400",
      "http://localhost:50839"
    ],
    "AntiForgeryHeaderName": "X-IRS-Request",
    "AntiForgeryHeaderValue": "1",
    "MaxRequestBodySizeBytes": 8388608,
    "ReadRequestsPerMinute": 300,
    "WriteRequestsPerMinute": 60,
    "LoginAttemptsPerMinute": 5
  }
}
